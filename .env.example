# Cloud database (PostgreSQL). Leave empty to use local SQLite file (for testing only).
DATABASE_URL=postgresql://user:password@host:5432/warehouse
# Long random string used to sign login tokens
SECRET_KEY=change-this-to-a-long-random-string
# First-run admin account (change password after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set to 1 to allow stock-out to push balance below zero
ALLOW_NEGATIVE_STOCK=0
